# Copy to .env.local (never commit it) or set these in your shell / service environment.
# Next.js loads .env.local automatically; these are read on the server only and never reach the browser.
# On the office server the file is C:\MbalBI\.env.production.local (see docs/deployment.md).

# Where data comes from: "sample" (default, synthetic fixtures, no network) or "oracle" (live Orion).
MBAL_DATA_SOURCE=sample

# Only needed when MBAL_DATA_SOURCE=oracle. There are no defaults: all three must be set.
# ORACLE_DSN is an Easy Connect string: host:port/service_name
# In production use the read-only app user from docs/deployment.md, never MBALI.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=

# Microsoft sign-in (Entra ID, MBAL's tenant). Sign-in is on once the first four are all set.
# Without them sample mode stays open, and a production server in oracle mode serves no data.
# AUTH_SECRET: random, at least 32 bytes. PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
AUTH_SECRET=
# From the app registration: Application (client) ID, a client secret value, Directory (tenant) ID.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# The address people open, behind the HTTPS reverse proxy. Entra's redirect URI is
# <AUTH_URL>/api/auth/callback/microsoft-entra-id. Plain http only for local testing.
AUTH_URL=
# Optional: an Entra group object id. Only its members get in; empty means anyone in the tenant.
AUTH_ALLOWED_GROUP=

# Bearer token for /api/cron/* (scheduled jobs, such as the daily snapshot email below). Empty
# rejects every cron call. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Daily snapshot email (POST /api/cron/snapshot, preview at /snapshot) ---------------------
# Where the dashboards live, for the links in the email (e.g. https://bi.mbal.local). Defaults to
# the address the request came in on, which for the scheduled task is localhost.
APP_URL=
# "file" (default: writes snapshot-<date>.html and .txt to SNAPSHOT_DIR) or "graph" (sends email).
SNAPSHOT_TRANSPORT=file
SNAPSHOT_DIR=./snapshots
# Comma-separated recipients.
SNAPSHOT_TO=
# Only for SNAPSHOT_TRANSPORT=graph: the shared mailbox to send as, and an Entra ID app with the
# Mail.Send application permission, limited to that mailbox (see README, "Daily snapshot email").
SNAPSHOT_FROM=
SNAPSHOT_TENANT_ID=
SNAPSHOT_CLIENT_ID=
SNAPSHOT_CLIENT_SECRET=
